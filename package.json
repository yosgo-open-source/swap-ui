{
  "name": "@yosgo/swap-ui",
  "version": "2.0.0-beta.9",
  "description": "SWAP UI theme & components on MUI v9. www.swap.work",
  "type": "module",
  "main": "./build/index.cjs",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "build-storybook": "storybook build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yosgo-open-source/swap-ui.git"
  },
  "keywords": [
    "React",
    "Component",
    "Library",
    "MUI",
    "Design-Tokens",
    "Storybook"
  ],
  "author": "kcin1993",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yosgo-open-source/swap-ui/issues"
  },
  "homepage": "https://github.com/yosgo-open-source/swap-ui",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mui/material": "^9.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@fontsource/m-plus-rounded-1c": "5.2.10",
    "@fontsource/noto-sans-tc": "5.2.9",
    "@mui/x-date-pickers": "^9.9.0",
    "dayjs": "^1.11.21",
    "react-share": "^5.3.0"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "^10.5.0",
    "tsup": "8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "4.1.10"
  }
}
